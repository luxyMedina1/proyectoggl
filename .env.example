# =============================================================================
#  TaquillaVip — variables de entorno
#
#  Copia este archivo a `.env.local` y rellena los valores:
#      cp .env.example .env.local
#
#  `.env.local` está en .gitignore y NUNCA se commitea. Este archivo sí, y por
#  eso sólo lleva placeholders: no pongas credenciales reales aquí.
#
#  Regla de oro: el prefijo NEXT_PUBLIC_ significa literalmente "publica esto".
#  Next inlinea esas variables en el JavaScript que descarga cualquier visitante,
#  así que se leen con Ctrl+U. Todo lo que sea secreto va SIN prefijo.
# =============================================================================


# -----------------------------------------------------------------------------
#  Backend
# -----------------------------------------------------------------------------

# URL base del backend, SIN `/api/v1` al final: el código lo añade.
NEXT_PUBLIC_URL_BACKEND=https://api.ejemplo.com

# API key que el backend espera en el header `x-api-key`.
#
# HOY ESTA KEY VIAJA AL NAVEGADOR y cualquiera la puede leer. Es un hallazgo
# abierto de la auditoría. Se queda con prefijo público porque
# api/apiApplication.ts corre en el navegador y no tiene alternativa hasta que
# la sesión pase a una cookie httpOnly.
#
# Los cuatro consumidores de SERVIDOR (getSiteConfig, ogEvento, sitemap,
# cosmotech) deberían migrar a la variable API_KEY de más abajo.
NEXT_PUBLIC_API_KEY=pon-aqui-la-api-key


# -----------------------------------------------------------------------------
#  Sitio
# -----------------------------------------------------------------------------

# Dominio público, con protocolo y SIN barra final.
#
# Es el `metadataBase` del layout raíz: sin él, Next no puede convertir las URLs
# relativas de Open Graph en absolutas y los scrapers de WhatsApp, Facebook y X
# descartan la `og:image` en silencio. También construye el canonical y la línea
# `sitemap:` de robots.txt.
#
# En local déjalo en http://localhost:3000. En staging y producción tiene que ser
# el dominio real de ese entorno, no el de producción en los dos.
# Usada por: app/layout.tsx, app/robots.ts, app/sitemap.ts, utils/ogEvento.ts
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre de marca de respaldo, para cuando /configuraciones/detail/1 no responde.
# El nombre real viene del backend (config.nombreMarca); esto es sólo el fallback.
# Usada por: app/layout.tsx, app/opengraph-image.tsx, utils/ogEvento.ts,
#            explorar/pages/ExplorarPage.tsx, perfil/components/BoletoCard.tsx
NEXT_PUBLIC_TITLE_APP=TaquillaVip

# Zona horaria para formatear TODAS las fechas de evento.
#
# Importa más de lo que parece: sin esto se usaría la zona del navegador, y un
# usuario en Tijuana vería la hora de su función corrida dos horas. También
# alimenta el sufijo de día en los slugs de eventos multifecha
# (`sky-fest-laguna-7-matutino`), así que cambiarla cambia URLs y QR impresos.
#
# Opcional: si falta, utils/dateHelpers.ts usa "America/Mexico_City".
# Usada por: utils/dateHelpers.ts
NEXT_PUBLIC_TIMEZONE=America/Mexico_City


# -----------------------------------------------------------------------------
#  Revalidación de caché  (server-only, sin prefijo — es un secreto)
# -----------------------------------------------------------------------------

# Secreto compartido con el backend para POST /api/revalidate, el endpoint que
# invalida el caché cuando alguien edita algo en el dashboard.
#
# Genérala con:  openssl rand -hex 32
#
# DISTINTA en cada entorno. Si staging y producción comparten el valor, un aviso
# de staging invalida el caché de producción.
#
# Si falta, el endpoint responde 401 a todo sin explicar por qué — es el fallo
# más común al montar esto.
#
# El backend necesita el MISMO valor en su variable FRONT_REVALIDATE_SECRET.
# Contrato completo: docs/checklist-migracion/03-revalidacion-desde-el-backend.md
# Usada por: app/api/revalidate/route.ts
REVALIDATE_SECRET=genera-uno-con-openssl-rand-hex-32


# -----------------------------------------------------------------------------
#  Pendiente de adoptar  (ver auditoría)
# -----------------------------------------------------------------------------
#
# Estas dos cierran el hallazgo de la API key expuesta. Los cuatro consumidores
# de servidor pasarían a leerlas, y la NEXT_PUBLIC_API_KEY quedaría sólo para
# api/apiApplication.ts, que sí corre en el navegador.
#
# Descomenta cuando se haga el cambio en el código.

# URL_BACKEND=https://api.ejemplo.com
# API_KEY=pon-aqui-la-api-key


# -----------------------------------------------------------------------------
#  Sólo para análisis manual del bundle  (no la pongas en .env.local)
# -----------------------------------------------------------------------------
#
# Se pasa en línea, no se declara:
#     ANALYZE=true npm run build
#
# Abre el treemap de @next/bundle-analyzer. Ver
# docs/checklist-migracion/08-code-splitting.md
